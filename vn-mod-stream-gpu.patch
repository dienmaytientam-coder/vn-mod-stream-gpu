+        for (size_t i = 0; i < ggml_backend_dev_count(); ++i) { if (ggml_backend_dev_type(ggml_backend_dev_get(i)) == GGML_BACKEND_DEVICE_TYPE_GPU) { ++gpus; } }
+        if (gpus != 1) { throw std::invalid_argument("select one device for auto streaming"); }
