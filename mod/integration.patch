     GGML_UNUSED(reg);
 }
 
+static ggml_backend_event_t ggml_backend_cuda_event_new_timed(ggml_backend_dev_t dev) {
+    auto * ctx = (ggml_backend_cuda_device_context *) dev->context;
+    ggml_cuda_set_device(ctx->device);
+    cudaEvent_t event;
+    CUDA_CHECK(cudaEventCreate(&event));
+    return new ggml_backend_event { dev, event };
+}
+
+static bool ggml_backend_cuda_event_query(ggml_backend_event_t event) {
+    const cudaError_t status = cudaEventQuery((cudaEvent_t) event->context);
+    if (status == cudaErrorNotReady) { return false; }
+    CUDA_CHECK(status);
+    return true;
+}
+
+static float ggml_backend_cuda_event_elapsed_ms(ggml_backend_event_t start, ggml_backend_event_t end) {
+    float ms = 0;
+    CUDA_CHECK(cudaEventElapsedTime(&ms, (cudaEvent_t) start->context, (cudaEvent_t) end->context));
+    return ms;
+}
+
+static bool ggml_backend_cuda_weight_stream_identity(ggml_backend_dev_t dev, char * identity, size_t capacity, int * cc) {
+    auto * ctx = (ggml_backend_cuda_device_context *) dev->context;
+    cudaDeviceProp prop;
+    if (cudaGetDeviceProperties(&prop, ggml_cuda_get_physical_device(ctx->device)) != cudaSuccess || capacity < 33) { return false; }
+    for (int i = 0; i < 16; ++i) { snprintf(identity + 2*i, capacity - 2*i, "%02x", (unsigned char) prop.uuid.bytes[i]); }
+    *cc = prop.major * 100 + prop.minor * 10;
+    return true;
+}
+
 static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
     GGML_UNUSED(reg);
+    if (strcmp(name, "ggml_backend_cuda_weight_stream_identity") == 0) { return (void *) ggml_backend_cuda_weight_stream_identity; }
+    if (strcmp(name, "ggml_backend_event_new_timed") == 0) { return (void *) ggml_backend_cuda_event_new_timed; }
+    if (strcmp(name, "ggml_backend_event_query") == 0) { return (void *) ggml_backend_cuda_event_query; }
+    if (strcmp(name, "ggml_backend_event_elapsed_ms") == 0) { return (void *) ggml_backend_cuda_event_elapsed_ms; }
     if (strcmp(name, "ggml_backend_comm_init") == 0) {
         return (void *)ggml_backend_cuda_comm_init;
     }
