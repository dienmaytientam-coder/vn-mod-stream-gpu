+void common_params_apply_vn_config(common_params & params, const std::string & path) {
+    std::error_code ec;
+    if (!std::filesystem::exists(path, ec)) {
+        if (ec) { throw std::runtime_error("cannot stat weight stream config: " + ec.message()); }
+        return;
+    }
+    const auto sections = common_read_ini(path);
+    for (const auto & section : sections) {
+        for (const auto & item : section.second) {
+            if (section.first == "vn-mod" && item.first == "gpu") {
+                params.vn_gpu_budget = item.second == "auto" ? 0 : llama_weight_stream_parse_size(item.second);
+            } else if (section.first == "vn-mod-gpu-wstream") {
+                if (item.first == "mode") {
+                    if (item.second != "off" && item.second != "auto") { throw std::invalid_argument("invalid weight stream mode"); }
+                    params.vn_wstream_mode = item.second;
+                } else if (item.first == "reserve") {
+                    params.vn_wstream_reserve = llama_weight_stream_parse_size(item.second, true);
+                } else if (item.first == "cache") {
+                    if (item.second != "true" && item.second != "false") { throw std::invalid_argument("invalid cache boolean"); }
+                    params.vn_wstream_cache = item.second == "true";
+                } else if (item.first == "cache_dir") {
+                    if (item.second.empty()) { throw std::invalid_argument("empty cache directory"); }
+                    params.vn_wstream_cache_dir = item.second;
+                } else { throw std::invalid_argument("unknown weight stream config key: " + item.first); }
+            }
+        }
+    }
+}
